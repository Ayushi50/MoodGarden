# Copy to .env.local (never commit it). Both values are in Supabase: Project Settings -> API.
# The anon key is meant to be public; the Row Level Security policy in supabase/schema.sql protects the data.
# Leave both unset and the app simply runs local-only with no sign-in option.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
