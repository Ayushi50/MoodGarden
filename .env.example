# Copy to .env.local (never commit it). Copy both public URLs from Neon env pull.
# These URLs are public; they contain no database username or password.
# Leave both unset and the app runs local-only with no sign-in option.
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.c-2.YOUR-REGION.aws.neon.build/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.c-2.YOUR-REGION.aws.neon.build/neondb/rest/v1
